{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 89",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "measure:search": "SEARCH_MEASUREMENT=1 playwright test e2e/search-pipeline-measurement.spec.ts --project=chromium",
    "measure:profile-posts": "PROFILE_POSTS_MEASUREMENT=1 playwright test e2e/profile-posts-measurement.spec.ts --project=chromium",
    "measure:infinite-scroll": "INFINITE_SCROLL_MEASUREMENT=1 playwright test e2e/infinite-scroll-measurement.spec.ts --project=chromium",
    "measure:log-batching": "LOG_BATCHING_MEASUREMENT=1 playwright test e2e/log-batching-measurement.spec.ts --project=chromium",
    "measure:log-rate": "LOG_RATE_MEASUREMENT=1 playwright test e2e/log-event-rate-measurement.spec.ts --project=chromium",
    "measure:log-loss": "LOG_LOSS_MEASUREMENT=1 playwright test e2e/log-loss-measurement.spec.ts --project=chromium",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@repo/dto": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.13.2",
    "lucide-react": "^0.562.0",
    "next": "16.0.10",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.2",
    "react-intersection-observer": "^10.0.0",
    "react-toastify": "^11.0.5",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/youtube": "^0.1.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "jsdom": "^30.0.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  }
}
