{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "SEARCH_MEASUREMENT",
    "SEARCH_MEASUREMENT_SESSIONS",
    "SEARCH_MEASUREMENT_WINDOW_MS",
    "SEARCH_MEASUREMENT_MOCK_DELAY_MS",
    "PROFILE_POSTS_MEASUREMENT",
    "PROFILE_POSTS_MEASUREMENT_MODE",
    "PROFILE_POSTS_MEASUREMENT_SESSIONS",
    "PROFILE_POSTS_MEASUREMENT_PAGE_SIZE",
    "PROFILE_POSTS_MEASUREMENT_MOCK_DELAY_MS",
    "INFINITE_SCROLL_MEASUREMENT",
    "INFINITE_SCROLL_MEASUREMENT_MODE",
    "INFINITE_SCROLL_MEASUREMENT_SESSIONS",
    "INFINITE_SCROLL_MEASUREMENT_PAGES",
    "INFINITE_SCROLL_MEASUREMENT_PAGE_SIZE",
    "INFINITE_SCROLL_MEASUREMENT_MOCK_DELAY_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**"],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
